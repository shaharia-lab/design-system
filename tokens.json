{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "VibeXP Design Tokens",
  "version": "1.0.0",
  "color": {
    "_comment": "OKLCH. Each role has a light + dark value. Brand is neutral black (= primary).",
    "background": { "light": "oklch(1 0 0)", "dark": "oklch(0.145 0 0)" },
    "foreground": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" },
    "card": { "light": "oklch(1 0 0)", "dark": "oklch(0.205 0 0)" },
    "card-foreground": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" },
    "popover": { "light": "oklch(1 0 0)", "dark": "oklch(0.205 0 0)" },
    "popover-foreground": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" },
    "primary": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.922 0 0)" },
    "primary-foreground": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.205 0 0)" },
    "secondary": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" },
    "secondary-foreground": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" },
    "muted": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" },
    "muted-foreground": { "light": "oklch(0.556 0 0)", "dark": "oklch(0.708 0 0)" },
    "accent": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" },
    "accent-foreground": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" },
    "destructive": { "light": "oklch(0.577 0.245 27.325)", "dark": "oklch(0.704 0.191 22.216)" },
    "destructive-foreground": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.985 0 0)" },
    "border": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 10%)" },
    "input": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 15%)" },
    "ring": { "light": "oklch(0.708 0 0)", "dark": "oklch(0.556 0 0)" },
    "chart-1": { "light": "oklch(0.646 0.222 41.116)", "dark": "oklch(0.488 0.243 264.376)" },
    "chart-2": { "light": "oklch(0.6 0.118 184.704)", "dark": "oklch(0.696 0.17 162.48)" },
    "chart-3": { "light": "oklch(0.398 0.07 227.392)", "dark": "oklch(0.769 0.188 70.08)" },
    "chart-4": { "light": "oklch(0.828 0.189 84.429)", "dark": "oklch(0.627 0.265 303.9)" },
    "chart-5": { "light": "oklch(0.769 0.188 70.08)", "dark": "oklch(0.645 0.246 16.439)" }
  },
  "brand": {
    "_comment": "Brand is neutral black; aliases reference primary so they flip with theme.",
    "brand": "{color.primary}",
    "brand-foreground": "{color.primary-foreground}"
  },
  "radius": {
    "_seed": "0.625rem",
    "sm": "calc(0.625rem - 4px)",
    "md": "calc(0.625rem - 2px)",
    "lg": "0.625rem",
    "xl": "calc(0.625rem + 4px)"
  },
  "font": {
    "system": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "inter": "'Inter', system-ui, Avenir, Helvetica, Arial, sans-serif",
    "poppins": "'Poppins', Inter, system-ui, Avenir, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'SFMono-Regular', 'JetBrains Mono', 'Menlo', 'Consolas', monospace",
    "_surface_map": {
      "app": "system",
      "website": "inter",
      "blog": "inter",
      "docs": "inter",
      "legacy-v1": "poppins"
    }
  },
  "typeScale": {
    "_comment": "px / weight / line-height",
    "ui": {
      "title": { "size": 24, "weight": 600, "lineHeight": 24 },
      "section": { "size": 18, "weight": 500, "lineHeight": 28 },
      "body": { "size": 14, "weight": 400, "lineHeight": 20 },
      "label": { "size": 14, "weight": 500, "lineHeight": 16 },
      "fine": { "size": 12, "weight": 600, "lineHeight": 16 }
    },
    "prose": {
      "h1": { "size": 24, "weight": 700, "lineHeight": 32 },
      "h2": { "size": 20, "weight": 600, "lineHeight": 28 },
      "h3": { "size": 18, "weight": 600, "lineHeight": 24 },
      "h4": { "size": 18, "weight": 600, "lineHeight": 24 },
      "h5": { "size": 16, "weight": 600, "lineHeight": 24 },
      "h6": { "size": 14, "weight": 600, "lineHeight": 20 },
      "body": { "size": 14, "weight": 400, "lineHeight": 24.5 }
    }
  }
}
