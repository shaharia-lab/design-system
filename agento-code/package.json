{
  "name": "agento-code",
  "version": "0.1.0",
  "description": "The agento-code design system — tokens, CSS foundations and React primitives for Shaharia Lab open-source project sites.",
  "license": "MIT",
  "author": "Shaharia Lab (https://shaharialab.com)",
  "homepage": "https://myagento.app",
  "repository": { "type": "git", "url": "git+https://github.com/shaharia-lab/agento.git" },
  "keywords": ["design-system", "agento", "shaharia-lab", "css-tokens", "react"],
  "sideEffects": ["*.css"],
  "type": "module",
  "exports": {
    "./styles.css": "./styles.css",
    "./base.css": "./base.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./components/*": "./components/*"
  },
  "files": [
    "INSTALL.md",
    "styles.css",
    "base.css",
    "tokens",
    "assets",
    "components",
    "guidelines",
    "readme.md",
    "SKILL.md"
  ],
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "publishConfig": { "access": "public" }
}
