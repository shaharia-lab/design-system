{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/navigation/**",
              "components/patterns/**",
              "ui_kits/docs/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Newsreader|Karla|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Newsreader, Karla, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|onClick|disabled|onInvert|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, onClick, disabled, onInvert, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|ink|ghost)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'ink' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Byline'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|name|role|style|key|ref|className|style|children)$/]",
        "message": "<Byline> doesn't accept that prop. Declared props: initials, name, role, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Closer'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|actions|style|children|key|ref|className|style|children)$/]",
        "message": "<Closer> doesn't accept that prop. Declared props: title, actions, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|children|style|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Crumbs> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:head|rows|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: head, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|summary|meta|recommended|open|defaultOpen|onToggle|style|children|key|ref|className|style|children)$/]",
        "message": "<Disclosure> doesn't accept that prop. Declared props: variant, summary, meta, recommended, open, defaultOpen, onToggle, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:faq|panel)$/]",
        "message": "<Disclosure> variant must be one of 'faq' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:end|style|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: end, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:copyright|links|aside|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: copyright, links, aside, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|links|current|star|theme|onTheme|style|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: label, links, current, star, theme, onTheme, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|hoverTint|style|children|key|ref|className|style|children)$/]",
        "message": "<NavButton> doesn't accept that prop. Declared props: href, onClick, hoverTint, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavButton'] > JSXAttribute[name.name='hoverTint'] > Literal[value!=/^(?:sunken|blue)$/]",
        "message": "<NavButton> hoverTint must be one of 'sunken' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|style|children|key|ref|className|style|children)$/]",
        "message": "<Note> doesn't accept that prop. Declared props: kind, label, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:note|warn)$/]",
        "message": "<Note> kind must be one of 'note' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pager'] > JSXAttribute > JSXIdentifier[name!=/^(?:prev|next|style|key|ref|className|style|children)$/]",
        "message": "<Pager> doesn't accept that prop. Declared props: prev, next, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|eyebrow|eyebrowEnd|title|style|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: variant, size, eyebrow, eyebrowEnd, title, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|flat|dashed|accent)$/]",
        "message": "<Panel> variant must be one of 'default' | 'flat' | 'dashed' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:panel|card)$/]",
        "message": "<Panel> size must be one of 'panel' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:plain|style|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: plain, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|date|title|description|tags|feature|style|key|ref|className|style|children)$/]",
        "message": "<PostRow> doesn't accept that prop. Declared props: href, date, title, description, tags, feature, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Row'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|badge|title|mono|right|go|recommended|style|children|key|ref|className|style|children)$/]",
        "message": "<Row> doesn't accept that prop. Declared props: href, badge, title, mono, right, go, recommended, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|shortcut|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SearchBox> doesn't accept that prop. Declared props: label, shortcut, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|label|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: title, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|style|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: variant, as, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|flat|dashed|accent)$/]",
        "message": "<Sheet> variant must be one of 'default' | 'flat' | 'dashed' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Shot'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|alt|caption|style|key|ref|className|style|children)$/]",
        "message": "<Shot> doesn't accept that prop. Declared props: name, src, alt, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:groups|current|style|key|ref|className|style|children)$/]",
        "message": "<SidebarNav> doesn't accept that prop. Declared props: groups, current, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|count|action|style|children|key|ref|className|style|children)$/]",
        "message": "<StarBand> doesn't accept that prop. Declared props: eyebrow, title, count, action, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<StatGrid> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Steps'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Steps> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toc'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|current|label|style|key|ref|className|style|children)$/]",
        "message": "<Toc> doesn't accept that prop. Declared props: items, current, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|size|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: href, label, size, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
