{
  "name": "@shaharia-lab/design-system",
  "version": "0.4.0",
  "description": "Unified design system across all shaharia-lab services — shadcn/ui default theme, neutral base, OKLCH tokens, full light/dark parity.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaharia-lab/design-system.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "index.css",
  "style": "index.css",
  "exports": {
    ".": "./index.css",
    "./css": "./index.css",
    "./tokens.css": "./tokens/tokens.css",
    "./theme.css": "./tokens/theme.css",
    "./prose.css": "./tokens/prose.css",
    "./fonts.css": "./tokens/fonts.css",
    "./a11y.css": "./tokens/a11y.css",
    "./tokens.json": "./tokens.json",
    "./brand/*": "./brand/*"
  },
  "files": [
    "index.css",
    "tokens/",
    "tokens.json",
    "brand/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "design-system",
    "design-tokens",
    "shadcn",
    "tailwindcss",
    "oklch",
    "shaharia-lab"
  ]
}
